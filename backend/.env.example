DATABASE_URL=postgresql+asyncpg://user:password@ep-xxxx.neon.tech/outpath?ssl=require
SECRET_KEY=replace-with-a-long-random-value
ALLOWED_ORIGINS=["https://outpath.vercel.app", "http://localhost:5173", "http://127.0.0.1:5173"]
# Google Identity Services client ID used by React and verified by FastAPI
GOOGLE_CLIENT_ID=
ENVIRONMENT=development

# Local convenience only. Production deployments should run Alembic before boot.
AUTO_MIGRATE=true

# In production (Vercel frontend + Render backend), session cookies use SameSite=None + Secure automatically.

