# FastAPI backend origin
VITE_API_URL=http://localhost:8000
# Chrome extension id used for the local bridge handshake
VITE_BRIDGE_EXTENSION_ID=06612ea2ea284ec39bd19ef5fbf1523630e4fa972d2ffb459d598b845572b3d0

# Direct Chrome Web Store/download page for the Outpath Local Bridge
VITE_EXTENSION_INSTALL_URL=https://chromewebstore.google.com/detail/outpath-local-bridge/06612ea2ea284ec39bd19ef5fbf1523630e4fa972d2ffb459d598b845572b3d0

# Google Identity Services client ID (React-side sign-in; no client secret required)
VITE_GOOGLE_CLIENT_ID=

# Production on Vercel uses the same-origin /api rewrite by default.
# Set false only if you intentionally want direct cross-origin API calls.
VITE_API_SAME_ORIGIN=true
