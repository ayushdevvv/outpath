{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://outpath.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "local-network-access=(self); local-network=(self); loopback-network=(self)"
        }
      ]
    }
  ]
}
